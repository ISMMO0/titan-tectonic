# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (Project Settings → API) -------------------------------
# Public values: safe in the browser, data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Do NOT add the service_role / secret key here — the app never needs it.

# --- Gemini (server only) --------------------------------------------
# Local mode uses an AI Studio key. This key is not needed when Vertex AI is on.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloud Run mode: Application Default Credentials come from its service account.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Voice ------------------------------------------------------------
# gemini (uses GEMINI_API_KEY) | elevenlabs (TODO) | browser (built-in voice, no key)
VOICE_PROVIDER=gemini
GEMINI_STT_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# --- ElevenLabs (server only, when credits are back) -----------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
